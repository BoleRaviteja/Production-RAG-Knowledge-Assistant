# ---- App ----
ENVIRONMENT=local
LOG_LEVEL=INFO
JWT_SECRET=change-me-to-a-long-random-string
DATABASE_URL=postgresql+psycopg://rag:rag@db:5432/rag

# ---- Embeddings ----
# "fake" = offline hashed embeddings (demo/tests only, lexical matching).
# "openai" = real semantic embeddings (needs OPENAI_API_KEY).
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
OPENAI_API_KEY=

# ---- LLM ----
# "mock" = returns the top retrieved passage (no API key needed).
# "anthropic" = Claude via the Anthropic API.
LLM_PROVIDER=mock
LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=

# ---- RAG tuning ----
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5
# With real embeddings 0.2-0.3 is a good floor. Use 0.0 with fake embeddings.
MIN_SIMILARITY=0.0
